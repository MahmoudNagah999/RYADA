# RYADA Docker stack environment (issue #36).
#
# Copy to `.env.docker` (git-ignored) and fill in the passwords:
#     Copy-Item .env.docker.example .env.docker
# Then generate a key and paste the value into APP_KEY:
#     docker compose run --rm app php artisan key:generate --show
#
# The values below are placeholders. Do not commit a real .env.docker.

APP_NAME=RYADA
# `local` keeps the stack a developer sandbox (matches .env.example); `production` would
# also work, but it only changes guards we do not need while iterating. APP_DEBUG is off
# so the nginx-facing responses match what production would return.
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# The application clock stays UTC; the business timezones below are DST-aware.
APP_TIMEZONE=UTC
SUBSCRIPTIONS_TIMEZONE=Africa/Cairo
ATTENDANCE_TIMEZONE=Africa/Cairo

# Send application errors to the container output so `docker compose logs app` shows them.
LOG_CHANNEL=stderr
LOG_LEVEL=debug

BCRYPT_ROUNDS=12

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ryada
DB_USERNAME=ryada
DB_PASSWORD=fake-app-password

# MySQL container bootstrap. Keep the three MYSQL_* values in sync with DB_* above:
# the entrypoint creates the user/database only on first start of an empty volume.
MYSQL_ROOT_PASSWORD=fake-root-password
MYSQL_DATABASE=ryada
MYSQL_USER=ryada
MYSQL_PASSWORD=fake-app-password

# The admin panel and Sanctum need sessions; the default database driver is what the app uses.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# One namespace per environment, so this stack never shares keys with local/Herd.
CACHE_PREFIX=ryada-docker-cache-
REDIS_PREFIX=ryada-docker-
HORIZON_PREFIX=ryada-docker-horizon:

FILESYSTEM_DISK=local
CLUB_LOGO_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME=RYADA

SANCTUM_STATEFUL_DOMAINS=localhost:8080

# Host ports are compose variables (shell environment or the project .env), not container
# variables, so they are not read from this file. Defaults: nginx 8080, MySQL 3307.
#   PowerShell: $env:APP_PORT = 8081; $env:DB_FORWARD_PORT = 3308; docker compose up -d
